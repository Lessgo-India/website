{
  "id": "/partner",
  "name": "Lessgo Partner Portal",
  "short_name": "Lessgo Partners",
  "description": "Create Lessgo offers, manage campaigns, redeem vouchers, and review partner performance.",
  "start_url": "/partner/login?source=pwa",
  "scope": "/partner",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#7c48e0",
  "categories": ["business", "productivity"],
  "icons": [
    {
      "src": "/partner/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/partner/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/partner/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Partner overview",
      "short_name": "Overview",
      "url": "/partner/dashboard",
      "icons": [{ "src": "/partner/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Campaigns",
      "short_name": "Campaigns",
      "url": "/partner/campaigns",
      "icons": [{ "src": "/partner/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Redeem a voucher",
      "short_name": "Redeem",
      "url": "/partner/redeem",
      "icons": [{ "src": "/partner/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
