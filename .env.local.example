# ---- Lessgo web client (Next.js) ----
#
# The web client does exactly two things: let an invited guest sign up with
# their phone number, and let them RSVP. Everything else lives in the app.
# The three blocks below are ALL required for that flow to work.

# Gateway base URL — same value as the mobile app's EXPO_PUBLIC_VITE_BACKEND_API
NEXT_PUBLIC_BACKEND_API=https://your-gateway.example.com

# Absolute public URL of THIS site. Used as the metadata base for OG/social tags,
# and it must match the WEB_APP_URL set on backend-event-service, which texts
# invitees a "{WEB_APP_URL}/e/{eventId}" link.
NEXT_PUBLIC_SITE_URL=https://lessgo.example.com

# Live product pages only. Badges render once `storesLive` is true in content/site.ts.
NEXT_PUBLIC_ANDROID_APP_URL=
NEXT_PUBLIC_IOS_APP_URL=

# ---- Firebase Web SDK (Firebase project: lessgo-mobile) ----
# Steps in the Firebase console (project lessgo-mobile):
#   1. Add a **Web app** and copy its config values below.
#   2. Authentication > Sign-in method: enable **Phone**.
#   3. Authentication > Settings > Authorized domains: add this site's domain
#      (and localhost for dev). Phone auth on web uses reCAPTCHA.
# The gateway must also run with FIREBASE_SERVICE_ACCOUNT_BASE64 set for the
# SAME project, or it cannot verify the ID tokens this client sends.
# These NEXT_PUBLIC_* values are safe to embed in the client bundle.
# apiKey + appId come from the Web app's firebaseConfig snippet; the rest are
# project-wide and already filled in.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=lessgo-mobile.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=lessgo-mobile
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=lessgo-mobile.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1015968015892

# ---- Admin dashboard (/admin) ----
# SERVER-SIDE ONLY. None of these may ever gain a NEXT_PUBLIC_ prefix: those are
# inlined into the browser bundle at build time, which would publish the
# credentials and make the whole gate bypassable.
#
# Generate an ADMIN_USERS entry (and a session secret) with:
#   node scripts/hash-admin-password.mjs
#
# Format: phone:saltHex:hashHex — comma-separate multiple operators. The stored
# value is a scrypt hash of the PBKDF2 digest the browser derives, so neither
# this file nor the network ever carries the password itself.
ADMIN_USERS=
# Signs the httpOnly session cookie. Any 32+ byte random hex string; rotating it
# invalidates every live session.
ADMIN_SESSION_SECRET=
# Gateway base URL for admin calls. Defaults to NEXT_PUBLIC_BACKEND_API.
ADMIN_GATEWAY_URL=
# Shared secret sent server-to-server as x-admin-api-key. Must equal the
# gateway's ADMIN_API_KEY.
ADMIN_GATEWAY_KEY=

# Shared rate-limit storage for admin sign-in. Defaults to MONGODB_URL / MONGODB_DB
# when omitted. Production sign-in fails closed if neither Mongo URL is set.
ADMIN_LOGIN_RATE_LIMIT_MONGODB_URL=
ADMIN_LOGIN_RATE_LIMIT_MONGODB_DB=

# Optional dedicated storage for credential overrides, active sessions, and
# password-change OTP challenges. Defaults to the login-rate-limit Mongo values,
# then MONGODB_URL / MONGODB_DB when omitted.
ADMIN_AUTH_MONGODB_URL=
ADMIN_AUTH_MONGODB_DB=

# Public half of the notification service's stable Admin Web Push VAPID pair.
# The corresponding private key is server-only and belongs exclusively on the
# notification API/worker deployments.
NEXT_PUBLIC_ADMIN_VAPID_PUBLIC_KEY=

# ---- Marketing site ----

# Product analytics. Loaded ONLY after the visitor accepts the consent banner.
# Leave blank to ship the site with analytics fully disabled.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Early-access signup storage. Both values are server-only and must never use a
# NEXT_PUBLIC_ prefix. The API creates an `interest_signups` collection with a
# unique email index. MONGODB_DB is optional; without it the URI's database is
# used. Prefer a dedicated database/user with access only to this collection.
MONGODB_URL=
MONGODB_DB=marketing
