# ---- Lessgo web client (Next.js) ----

# Gateway base URL — same value as the mobile app's EXPO_PUBLIC_VITE_BACKEND_API
NEXT_PUBLIC_BACKEND_API=https://your-gateway.example.com

# Absolute public URL of THIS site (used as the metadata base for OG/social tags). Optional.
NEXT_PUBLIC_SITE_URL=https://lessgo.example.com

# "Download App" button targets (auto-picked by iOS/Android; both shown on desktop)
NEXT_PUBLIC_ANDROID_APP_URL=https://play.google.com/store/apps/details?id=com.lessgo.india
NEXT_PUBLIC_IOS_APP_URL=

# ---- Firebase Web SDK (Firebase project: lessgo-mobile) ----
# Steps in the Firebase console (project lessgo-mobile):
#   1. Add a **Web app** and copy its config values below.
#   2. Authentication > Sign-in method: enable **Phone**.
#   3. Authentication > Settings > Authorized domains: add this site's domain
#      (and localhost for dev). Phone auth on web uses reCAPTCHA.
# These NEXT_PUBLIC_* values are safe to embed in the client bundle.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=lessgo-mobile.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=lessgo-mobile
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=lessgo-mobile.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1015968015892
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Marketing site ----

# Product analytics. Loaded ONLY after the visitor accepts the consent banner.
# Leave blank to ship the site with analytics fully disabled.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Where early-access signups are forwarded (a form service, Slack webhook,
# Airtable automation…). Receives JSON: { email, source, submittedAt }.
# Server-only — never exposed to the browser. Until this is set, the signup
# form tells visitors to email us instead of silently dropping their address.
EARLY_ACCESS_WEBHOOK_URL=
