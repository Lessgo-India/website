2:T9da,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is Lessgo free?","acceptedAnswer":{"@type":"Answer","text":"Yes. Creating events, RSVPs, groups, vibes and expense splitting are all free, and there are no ads. If we ever add a paid tier it will be for extras, never for the basics."}},{"@type":"Question","name":"Why does Lessgo need my contacts?","acceptedAnswer":{"@type":"Answer","text":"Lessgo is built around the friends you already have, so we match your contacts against people already on Lessgo to show you who you can invite. We never message your contacts on your behalf, and we never sell or share contact data. You can use the app without granting the permission — you will just have to invite people by link instead."}},{"@type":"Question","name":"Do my friends need the app to RSVP?","acceptedAnswer":{"@type":"Answer","text":"No. Every event has a shareable web link. Anyone can open it in a browser, see the details and RSVP after a quick phone verification. The app unlocks the extras — photos, expense splitting, chat and notifications."}},{"@type":"Question","name":"How does splitting expenses work?","acceptedAnswer":{"@type":"Answer","text":"Add what you spent to an event and pick who it was for. Lessgo works out the net balance between each pair of people, so instead of ten small debts you get one number per friend. You can settle over UPI and export the full ledger as a PDF or CSV."}},{"@type":"Question","name":"Who can see my plans?","acceptedAnswer":{"@type":"Answer","text":"Only people you invite. Events are visible to their guest list, and vibes are visible only to friends already in your contacts. There is no public feed and no way for a stranger to find you."}},{"@type":"Question","name":"Which platforms is Lessgo on?","acceptedAnswer":{"@type":"Answer","text":"Lessgo is a native app for Android and iOS, plus a lightweight web view for shared event links. Android and iOS builds are in early access right now — join the list and we will send you the download the moment it opens up."}},{"@type":"Question","name":"Is there a minimum age?","acceptedAnswer":{"@type":"Answer","text":"Yes — you need to be at least 13 to use Lessgo, and older where local law requires it."}},{"@type":"Question","name":"How do I delete my account?","acceptedAnswer":{"@type":"Answer","text":"Open Profile, then Data & Privacy, then Delete Profile. Your account and associated data are removed. You can also write to us and we will handle it."}}]}0:["kI3bFSeK2PjTd6BUB7jLT",[[["",{"children":["(marketing)",{"children":["help",{"children":["__PAGE__",{}]}]}]},"$undefined","$undefined",true],["",{"children":["(marketing)",{"children":["help",{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://lessgo.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Help\",\"item\":\"https://lessgo.com/help\"}]}"}}],["$","section",null,{"className":"relative isolate overflow-hidden pb-14 pt-16 sm:pb-20 sm:pt-24","children":[["$","div",null,{"aria-hidden":"true","className":"pointer-events-none absolute inset-0 overflow-hidden ","children":[["$","div",null,{"className":"absolute -left-[18%] -top-[30%] h-[42rem] w-[42rem] rounded-full blur-[110px] animate-aurora-a opacity-60","style":{"opacity":"var(--aurora-opacity)","background":"radial-gradient(circle at 30% 30%, #22D3C5 0%, rgba(71,118,230,0.65) 42%, transparent 70%)"}}],["$","div",null,{"className":"absolute -right-[16%] top-[-14%] h-[38rem] w-[38rem] rounded-full blur-[120px] animate-aurora-b opacity-60","style":{"opacity":"var(--aurora-opacity)","background":"radial-gradient(circle at 60% 40%, #EC008C 0%, rgba(142,84,233,0.7) 45%, tran